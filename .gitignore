data/*

# Allow keeping the folder itself
!data/.gitkeep


# Ignore package metadata
*.egg-info/

# Ignore environment files
*.env
*.venv
.env/
.venv/

# Ignore Python bytecode
__pycache__/

# Ignore build artifacts
build/
dist/

# submodule
libraries/fourierfun
